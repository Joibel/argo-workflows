####################################################################################################
# argoexec.exe is NOT compiled here. It is cross-compiled from Linux in the Nix
# development shell (`nix develop --command make dist/argoexec.exe`) and this
# file only assembles the image, so the Windows runner never needs a Go
# toolchain and there is no second Go version to keep in step with go.mod.
####################################################################################################

ARG IMAGE_OS_VERSION=ltsc2022-amd64

####################################################################################################
# Files the nanoserver base does not ship but argoexec needs at runtime:
# netapi32.dll (Go's os/user calls into it) and the 7-Zip console binary that
# is put on PATH for user containers. Servercore has the former; the latter
# comes from Chocolatey because 7-Zip publishes no other unpackable download.
# Nothing is built here.
####################################################################################################
FROM mcr.microsoft.com/windows/servercore:${IMAGE_OS_VERSION} AS runtime-deps
SHELL ["powershell", "-Command"]

ENV chocolateyUseWindowsCompression=false
RUN iex ((new-object net.webclient).DownloadString('https://chocolatey.org/install.ps1')); \
    choco feature disable --name showDownloadProgress ; \
    choco feature enable -n allowGlobalConfirmation
RUN choco install 7zip.portable

####################################################################################################
# argoexec-base
# Used as the base for both the release and development version of argoexec
####################################################################################################
FROM mcr.microsoft.com/windows/nanoserver:${IMAGE_OS_VERSION} AS argoexec-base
COPY --from=runtime-deps /windows/system32/netapi32.dll /windows/system32/netapi32.dll

COPY --from=runtime-deps C:/ProgramData/chocolatey/lib/7zip.portable/tools/7z-extra/x64/7za.exe C:/app/7za.exe

# add binaries to path
USER Administrator
RUN SETX /m path C:\app;%path%

####################################################################################################
# argoexec
####################################################################################################
FROM argoexec-base AS argoexec
COPY dist/argoexec.exe C:/app/argoexec.exe
RUN argoexec version
ENTRYPOINT [ "argoexec" ]
